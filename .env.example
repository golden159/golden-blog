# GitHub Stats (server-only)
GITHUB_TOKEN=

# NetEase Cloud Music (optional Hobby recent activity)
NETEASE_API_BASE_URL=
NETEASE_MUSIC_COOKIE=
NETEASE_USER_ID=3719820729

# Steam Web API (server-only Hobby Games activity)
STEAM_WEB_API_KEY=

# TinaCMS Cloud (only needed to edit via the hosted /admin in production)
# Get both from your project at app.tina.io after connecting this repo.
# NEXT_PUBLIC_* is exposed to the browser; TINA_TOKEN is a server-only secret.
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=
